# Copy this file to .env and configure a local, non-production database URL.

SERVER_PORT=8080
SERVER_ENV=development
DATABASE_URL=
DATABASE_MAX_CONNS=25
DATABASE_MIN_CONNS=5
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_CIDRS=
PUBLIC_WEB_URL=http://localhost:3000
# SMTP is optional locally. Configure TLS-capable SMTP to deliver password-reset links.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
